{
  "name": "jju-workshop-system",
  "version": "0.1.0",
  "private": true,
  "description": "General car workshop POS/CRM system (Cloudflare Workers + D1). Pilot client: JJU Auto Garage.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply jju-system-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jju-system-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
